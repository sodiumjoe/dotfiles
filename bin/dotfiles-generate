#!/usr/bin/env bash
set -euo pipefail

# Regenerate config files from base + environment overlays.
# Called by bootstrap.sh and the post-merge git hook.
#
# Static files (CLAUDE.md, AGENTS.md, Brewfile) are always regenerated.
# Mutable files (settings.json, config.toml) are only generated if they
# don't exist, since tools modify them at runtime. Use --reset to force.
#
# Requires DOTFILES_ENV to be set (or ~/.dotfiles-env to exist).

cd "$(dirname "$0")/.."  # cd to dotfiles root

reset=false
if [ "${1:-}" = "--reset" ]; then
  reset=true
fi

if [ -z "${DOTFILES_ENV:-}" ]; then
  if [ -f ~/.dotfiles-env ]; then
    . ~/.dotfiles-env
  else
    echo "dotfiles-generate: DOTFILES_ENV not set and ~/.dotfiles-env not found"
    exit 1
  fi
fi

# --- Static: Agent instructions (always regenerated) ---

echo "Generating CLAUDE.md..."
{
  cat shared/base-instructions.md
  printf '\n\n'
  cat shared/work-tracking.md
  printf '\n\n'
  cat shared/neovim.md
  printf '\n\n'
  cat claude-overlay.md
} > claude/CLAUDE.md

if [ "$DOTFILES_ENV" = "work" ] || [ "$DOTFILES_ENV" = "devbox" ]; then
  echo "Generating AGENTS.md..."
  mkdir -p codex
  {
    cat shared/base-instructions.md
    printf '\n\n'
    cat shared/work-tracking.md
    printf '\n\n'
    cat codex-overlay.md
  } > codex/AGENTS.md
fi

# --- Static: Brewfile (always regenerated, macOS only) ---

if [ "$(uname -s)" = "Darwin" ] && [ "$DOTFILES_ENV" != "devbox" ]; then
  echo "Generating Brewfile (base + ${DOTFILES_ENV})..."
  cat Brewfile.base > Brewfile
  if [ -f "Brewfile.${DOTFILES_ENV}" ]; then
    printf '\n' >> Brewfile
    cat "Brewfile.${DOTFILES_ENV}" >> Brewfile
  fi
fi

# --- Mutable: Claude settings (generate once, skip if exists) ---

generate_claude_settings() {
  # work and devbox share the same settings overlay (work)
  case "$DOTFILES_ENV" in
    work|devbox) local overlay="claude/settings.work.json" ;;
    home)        local overlay="claude/settings.home.json" ;;
    *)           local overlay="" ;;
  esac

  if [ -z "$overlay" ] || [ ! -f "$overlay" ]; then
    echo "Warning: settings overlay not found, using base only"
    cp claude/settings.base.json claude/settings.json
    return
  fi

  if ! command -v jq &>/dev/null; then
    echo "Warning: jq not found, using base settings only (install jq and re-run)"
    cp claude/settings.base.json claude/settings.json
    return
  fi

  echo "Generating claude/settings.json (base + ${overlay})..."
  # Merge contract: see claude/settings-merge.jq
  #   Scalar/object keys: overlay wins ($base * $overlay)
  #   Array keys below: concatenated (base + overlay)
  #   Object keys below: merged (base * overlay, overlay adds keys)
  # If you add a NEW array-valued key to settings, add it to the .jq file or
  # the overlay will silently replace instead of append.
  jq -s -f claude/settings-merge.jq claude/settings.base.json "$overlay" > claude/settings.json
}

if [ "$reset" = true ] || [ ! -f claude/settings.json ]; then
  generate_claude_settings
else
  echo "Skipping claude/settings.json (exists, use --reset to regenerate)"
fi

# --- Mutable: Codex config (generate once, skip if exists) ---

generate_codex_config() {
  if [ "$DOTFILES_ENV" != "work" ] && [ "$DOTFILES_ENV" != "devbox" ]; then
    return
  fi

  mkdir -p codex
  # codex/config.toml doesn't need merging — it's entirely work-specific
  # so we just copy it as-is
  echo "Generating codex/config.toml..."
  cp codex/config.base.toml codex/config.toml
}

if [ "$reset" = true ] || [ ! -f codex/config.toml ]; then
  generate_codex_config
else
  echo "Skipping codex/config.toml (exists, use --reset to regenerate)"
fi

echo "Config generation complete (DOTFILES_ENV=${DOTFILES_ENV})."

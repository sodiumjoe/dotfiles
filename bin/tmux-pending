#!/usr/bin/env bash

PENDING_TOKEN=$'\xe2\x81\xa3'

sync_session_pending() {
  local session_id="$1" pending_windows
  if [[ -z "$session_id" ]]; then
    return
  fi

  pending_windows=$(tmux list-windows -t "$session_id" -F '#{@pending}' 2>/dev/null) || return
  if printf '%s\n' "$pending_windows" | grep -qx '1'; then
    tmux set-option -t "$session_id" @session_pending 1 2>/dev/null || true
  else
    tmux set-option -u -t "$session_id" @session_pending 2>/dev/null || true
  fi
}

sync_remote_pending() {
  local pane="$1" title="$2" remote_host="$3"
  if [[ -z "$remote_host" && "$title" != *"󰌗 "* ]]; then
    return
  fi
  case "$title" in
    *"$PENDING_TOKEN"*)
      tmux set-option -w -t "$pane" @remote_pending 1 2>/dev/null || true
      ;;
    *)
      tmux set-option -wu -t "$pane" @remote_pending 2>/dev/null || true
      ;;
  esac
}

resolve_control_path() {
  local pane="$1" remote_host="$2" control_path="$3" resolved_path
  case "$control_path" in
    *%*)
      resolved_path=$(ssh -G -o ControlPath="$control_path" "$remote_host" 2>/dev/null |
        awk '$1 == "controlpath" { print $2; exit }') || return
      if [[ -z "$resolved_path" ]]; then
        return 1
      fi
      tmux set-option -p -t "$pane" @remote_control_path "$resolved_path" 2>/dev/null || true
      printf '%s\n' "$resolved_path"
      ;;
    *)
      printf '%s\n' "$control_path"
      ;;
  esac
}

set_remote_pane_visibility() {
  local pane="$1" window_active="$2" session_attached="$3" title="$4"
  local remote_host="$5" control_path="$6" visible remote_command
  case "$title" in
    *"󰌗 "*) ;;
    *) return ;;
  esac

  if [[ -z "$remote_host" || -z "$control_path" ]]; then
    return
  fi

  if ! control_path=$(resolve_control_path "$pane" "$remote_host" "$control_path"); then
    return
  fi

  if [[ "$window_active" == "1" && "$session_attached" != "0" ]]; then
    visible=1
  else
    visible=0
  fi

  remote_command="\$HOME/bin/tmux-pending set-visible $visible"
  ssh -n -S "$control_path" \
    -o ControlMaster=no \
    -o ProxyCommand=false \
    -o BatchMode=yes \
    "$remote_host" "$remote_command" >/dev/null 2>&1 || true
}

sync_remote_pane() {
  local pane="$1" context window_active session_attached title remote_host control_path
  context=$(tmux display-message -p -t "$pane" \
    '#{window_active}|#{session_attached}|#{pane_title}|#{@remote_host}|#{@remote_control_path}' 2>/dev/null) || return
  IFS='|' read -r window_active session_attached title remote_host control_path <<< "$context"
  sync_remote_pending "$pane" "$title" "$remote_host"
  set_remote_pane_visibility \
    "$pane" "$window_active" "$session_attached" "$title" "$remote_host" "$control_path"
}

sync_remote_panes() {
  local pane window_active session_attached title remote_host control_path
  while IFS='|' read -r pane window_active session_attached title remote_host control_path; do
    if [[ -n "$pane" ]]; then
      sync_remote_pending "$pane" "$title" "$remote_host"
      set_remote_pane_visibility \
        "$pane" "$window_active" "$session_attached" "$title" "$remote_host" "$control_path"
    fi
  done < <(tmux list-panes -a \
    -F '#{pane_id}|#{window_active}|#{session_attached}|#{pane_title}|#{@remote_host}|#{@remote_control_path}' 2>/dev/null)
}

set_session_visibility() {
  local visible="$1" context pane session_id
  case "$visible" in
    0|1) ;;
    *) return 2 ;;
  esac

  tmux set-option -g @session_visible "$visible" 2>/dev/null || return
  if [[ "$visible" == "0" ]]; then
    return
  fi

  context=$(tmux display-message -p '#{pane_id}|#{session_id}' 2>/dev/null) || return
  IFS='|' read -r pane session_id <<< "$context"
  tmux set-option -wu -t "$pane" @pending 2>/dev/null || true
  sync_session_pending "$session_id"
}

case "${1:-mark}" in
  mark)
    PANE="${2:-${TMUX_PANE:-}}"
    if [[ -z "$PANE" ]]; then
      exit 0
    fi
    CONTEXT=$(tmux display-message -p -t "$PANE" \
      '#{window_active}|#{session_attached}|#{@session_visible}|#{session_id}' 2>/dev/null) || exit 0
    IFS='|' read -r WINDOW_ACTIVE SESSION_ATTACHED SESSION_VISIBLE SESSION_ID <<< "$CONTEXT"
    SESSION_VISIBLE="${SESSION_VISIBLE:-1}"
    if [[ "$WINDOW_ACTIVE" == "1" && "$SESSION_ATTACHED" != "0" && "$SESSION_VISIBLE" == "1" ]]; then
      exit 0
    fi
    tmux set-option -w -t "$PANE" @pending 1 2>/dev/null || true
    sync_session_pending "$SESSION_ID"
    ;;
  clear)
    PANE="${2:-${TMUX_PANE:-}}"
    if [[ -z "$PANE" ]]; then
      exit 0
    fi
    CONTEXT=$(tmux display-message -p -t "$PANE" \
      '#{window_active}|#{session_attached}|#{@session_visible}|#{session_id}' 2>/dev/null) || exit 0
    IFS='|' read -r _ _ _ SESSION_ID <<< "$CONTEXT"
    tmux set-option -wu -t "$PANE" @pending 2>/dev/null || true
    sync_session_pending "$SESSION_ID"
    ;;
  sync-remote)
    PANE="${2:-}"
    if [[ -n "$PANE" ]]; then
      sync_remote_pane "$PANE"
    else
      sync_remote_panes
    fi
    ;;
  set-visible)
    set_session_visibility "${2:-}"
    ;;
esac

#!/usr/bin/env python3
import argparse
import json
import os
import pathlib
import sys


parser = argparse.ArgumentParser()
parser.add_argument("--preflight", action="store_true")
parser.add_argument("--generated-root", type=pathlib.Path)
arguments = parser.parse_args()
if arguments.generated_root is not None and not arguments.preflight:
    parser.error("--generated-root requires --preflight")

home = pathlib.Path(os.environ["HOME"]).resolve()
script = pathlib.Path(__file__).resolve()
repo = pathlib.Path(os.environ.get("DOTFILES_DIR", script.parents[2])).resolve()
source_root = repo / "home"
environment = os.environ["DOTFILES_ENV"]
valid_environments = {"work", "devbox", "home"}
if environment not in valid_environments:
    print(f"dotfiles-reconcile: invalid DOTFILES_ENV: {environment}", file=sys.stderr)
    raise SystemExit(2)
optional_environments = {
    pathlib.Path(".codex/AGENTS.md"): {"work", "devbox"},
    pathlib.Path(".codex/config.toml"): {"work", "devbox"},
    pathlib.Path("bin/work"): {"work", "devbox"},
}

tool_owned = {
    pathlib.Path(".codex/config.toml"),
    pathlib.Path(".config/karabiner/karabiner.json"),
}

applied = {
    pathlib.Path(".claude/settings.json"),
}

if not source_root.is_dir():
    print(f"dotfiles-reconcile: home tree is missing: {source_root}", file=sys.stderr)
    raise SystemExit(1)

generated_paths = {
    pathlib.Path(".claude/CLAUDE.md"),
    pathlib.Path(".claude/settings.json"),
    pathlib.Path(".codex/AGENTS.md"),
    pathlib.Path(".codex/config.toml"),
}
if arguments.generated_root is not None and not arguments.generated_root.is_dir():
    parser.error(f"generated tree is missing: {arguments.generated_root}")


def inside_repo(path):
    try:
        path.resolve(strict=False).relative_to(repo)
        return True
    except ValueError:
        return False


def relative_target(source, destination):
    return os.path.relpath(source, destination.parent)


entries = []
applies = []
optional_destinations = [
    home / relative
    for relative, enabled in optional_environments.items()
    if environment not in enabled
]
errors = []
runtime_directories = {
    pathlib.Path(".codex/plugins/cache"),
    pathlib.Path(".codex/skills/.system"),
    pathlib.Path(".codex/.tmp"),
    pathlib.Path(".codex/tmp"),
}


def runtime_path(relative):
    return relative in runtime_directories or (
        relative.parent == pathlib.Path(".codex")
        and (relative.name == "installation_id" or relative.match("*.sqlite*"))
    )


def source_files():
    for directory, subdirs, filenames in os.walk(source_root, followlinks=False):
        root = pathlib.Path(directory)
        subdirs[:] = [name for name in subdirs if not runtime_path((root / name).relative_to(source_root))]
        for name in subdirs + filenames:
            source = root / name
            relative = source.relative_to(source_root)
            if not runtime_path(relative) and (source.is_symlink() or source.is_file()):
                yield relative, source


sources = dict(source_files())
if arguments.generated_root is not None:
    for relative in generated_paths:
        sources.pop(relative, None)
        generated = arguments.generated_root / relative
        if generated.is_symlink() or generated.is_file():
            sources[relative] = generated

for relative, source in sorted(sources.items()):
    destination = home / relative
    if source.is_symlink():
        resolved = source.resolve(strict=False)
        if not resolved.exists() or not inside_repo(resolved):
            errors.append(f"invalid source alias: {source}")
            continue
        target_source = resolved
    else:
        target_source = source_root / relative
    enabled = optional_environments.get(relative)
    if enabled is not None and environment not in enabled:
        continue
    if relative in applied:
        applies.append((relative, source, destination))
        continue
    entries.append((source, target_source, destination))

required_parents = set()
for _, _, destination in entries + [(None, None, destination) for _, _, destination in applies]:
    parent = destination.parent
    while parent != home:
        required_parents.add(parent)
        parent = parent.parent
required_parents.update({home / ".claude", home / ".codex"})


def has_symlink_ancestor(destination):
    parent = destination.parent
    while parent != home:
        if parent.is_symlink():
            return True
        parent = parent.parent
    return False


for parent in sorted(required_parents, key=lambda path: len(path.parts)):
    if not parent.is_symlink() and parent.exists() and not parent.is_dir():
        errors.append(f"directory conflict: {parent}")

adoptions = []
for _, target_source, destination in entries:
    if has_symlink_ancestor(destination):
        continue
    if destination.is_symlink() or not destination.exists():
        continue
    if destination.relative_to(home) in tool_owned and destination.is_file():
        adoptions.append((destination, target_source))
        continue
    errors.append(f"destination conflict: {destination}")


def merge(live, desired):
    if isinstance(live, dict) and isinstance(desired, dict):
        merged = dict(live)
        for key, value in desired.items():
            merged[key] = merge(live[key], value) if key in live else value
        return merged
    return desired


def load_json(path):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        errors.append(f"invalid JSON: {path}")
        return None


applications = []
for relative, source, destination in applies:
    desired = load_json(source)
    if has_symlink_ancestor(destination) or not os.path.lexists(destination):
        live = {}
    elif destination.is_symlink():
        resolved = destination.resolve(strict=False)
        if not inside_repo(resolved) or not resolved.is_file():
            errors.append(f"destination conflict: {destination}")
            continue
        live = load_json(resolved)
    elif destination.is_file():
        live = load_json(destination)
    else:
        errors.append(f"destination conflict: {destination}")
        continue
    if desired is None or live is None:
        continue
    merged = merge(live, desired)
    if destination.is_symlink() or not destination.exists() or merged != live:
        applications.append((relative, destination, merged))


def differs(destination, target_source):
    return not target_source.is_file() or target_source.read_bytes() != destination.read_bytes()

if errors:
    for error in errors:
        print(f"dotfiles-reconcile: {error}", file=sys.stderr)
    raise SystemExit(1)

if arguments.preflight:
    for destination, target_source in adoptions:
        if differs(destination, target_source):
            print(f"dotfiles-reconcile: would adopt changes from {destination} into {target_source}")
    for relative, destination, _ in applications:
        print(f"dotfiles-reconcile: would apply {relative} to {destination}")
    print("dotfiles-reconcile: preflight passed")
    raise SystemExit(0)

changed = 0
for destination, target_source in adoptions:
    if not differs(destination, target_source):
        continue
    temporary = target_source.with_name(f".{target_source.name}.dotfiles-adopt.{os.getpid()}")
    temporary.write_bytes(destination.read_bytes())
    os.chmod(temporary, (target_source if target_source.exists() else destination).stat().st_mode & 0o7777)
    os.replace(temporary, target_source)
    print(f"dotfiles-reconcile: adopted changes from {destination} into {target_source}; review them with git diff or dotfiles-diff")

for parent in sorted(required_parents, key=lambda path: len(path.parts)):
    if parent.is_symlink():
        parent.unlink()
        changed += 1
    parent.mkdir(exist_ok=True)

for destination in optional_destinations:
    if destination.is_symlink() and inside_repo(destination):
        destination.unlink()
        changed += 1

for relative, destination, merged in applications:
    mode = destination.stat().st_mode & 0o7777 if destination.is_file() and not destination.is_symlink() else 0o644
    temporary = destination.with_name(f".{destination.name}.dotfiles-apply.{os.getpid()}")
    temporary.write_text(json.dumps(merged, indent=2) + "\n")
    os.chmod(temporary, mode)
    os.replace(temporary, destination)
    print(f"dotfiles-reconcile: applied {relative} to {destination}")
    changed += 1

for _, target_source, destination in entries:
    desired = relative_target(target_source, destination)
    if destination.is_symlink() and os.readlink(destination) == desired:
        continue
    temporary = destination.with_name(f".{destination.name}.dotfiles-link.{os.getpid()}")
    if os.path.lexists(temporary):
        temporary.unlink()
    temporary.symlink_to(desired)
    os.replace(temporary, destination)
    changed += 1

print(f"dotfiles-reconcile: changed={changed}")
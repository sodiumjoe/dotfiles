#!/usr/bin/env bash
# Regenerate STATIC configs after git pull.
# Only touches files that tools don't modify at runtime
# (CLAUDE.md, AGENTS.md, Brewfile). Mutable files like
# settings.json and config.toml are left alone.
#
# Git does not run post-merge for rebases, so `git pull --rebase` skips this
# entirely; run `dotfiles-generate` by hand after one.

cd "$(git rev-parse --show-toplevel)"

changed=$(git diff-tree -r --name-only ORIG_HEAD HEAD 2>/dev/null || true)

needs_regen=false
for pattern in \
  "Brewfile.base" "Brewfile.work" "Brewfile.home" \
  "shared/" "claude-overlay.md" "codex-overlay.md"; do
  if printf '%s\n' "$changed" | grep -qF "$pattern"; then
    needs_regen=true
    break
  fi
done

if [ "$needs_regen" = true ]; then
  echo "Source configs changed, regenerating static files..."
  bin/dotfiles-generate
fi

if printf '%s\n' "$changed" | grep -Eq '^(node-bin/package(-lock)?\.json|node-bin/sync-direct-bins\.mjs)$'; then
  echo "node-bin changed, refreshing pinned npm tools..."
  if [ -f node-bin/package-lock.json ]; then
    npm ci --prefix node-bin || echo "post-merge: npm ci failed — run 'npm ci --prefix node-bin' when the network is back" >&2
  else
    npm install --prefix node-bin || echo "post-merge: npm install failed — run 'npm install --prefix node-bin' when the network is back" >&2
  fi
  npm run sync-bins --prefix node-bin || echo "post-merge: node-bin bin sync failed — run 'npm run sync-bins --prefix node-bin' after npm install succeeds" >&2
fi

# Check for drift in mutable configs (settings.json, config.toml).
# Exit 1 means drift; exit 2 means the check could not run.
bin/dotfiles-diff --quiet
case $? in
  1)
    echo ""
    echo "Mutable config drift detected — run 'dotfiles-diff' to review"
    ;;
  2)
    echo ""
    echo "Could not check config drift — run 'dotfiles-diff' for details"
    ;;
esac
